# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL en produccion, SQLite en desarrollo)
# Si DEBUG=True, se usa SQLite automaticamente
# En Render: DATABASE_URL se genera automaticamente al crear la base de datos
DATABASE_URL=postgres://user:password@localhost:5432/simulacro_v2

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=VILLTECC <noreply@villtecc.com>

# WhatsApp (numero de la academia)
WHATSAPP_NUMERO=51916948025

# =============================================================================
# RENDER DEPLOYMENT
# =============================================================================
# En Render, configura las variables de entorno en el Dashboard:
# - SECRET_KEY: Genera uno nuevo (no uses el de desarrollo)
# - DEBUG: "false"
# - ALLOWED_HOSTS: "tu-servicio.onrender.com"
# - DATABASE_URL: Se genera automaticamente al crear la base de datos PostgreSQL
# - EMAIL_HOST_USER: Tu email de Gmail
# - EMAIL_HOST_PASSWORD: Tu contraseña de aplicacion de Gmail
# - WHATSAPP_NUMERO: "51916948025"
#
# Build command: ./build.sh
# Start command: gunicorn config.wsgi:application
#
# IMPORTANTE: Los archivos media (imagenes de preguntas, PDFs) se pierden
# en cada redeploy. Sube las imagenes de preguntas despues de cada deploy.
